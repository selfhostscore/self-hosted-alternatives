{
  // Cloudflare Worker (static assets only) that serves selfhostscore.com.
  // Deploy: node scripts/enrich.ts && node scripts/build-site.ts && npx wrangler deploy
  "name": "selfhostscore",
  "compatibility_date": "2026-06-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  }
}
